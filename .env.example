# Email Configuration (Nodemailer)
# Supports any SMTP provider: Gmail, Outlook, custom servers, Mailtrap, etc.

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Contact email where form submissions will be sent
CONTACT_EMAIL=hello@noonealone.com

# The email address used as "from" address for automated emails
FROM_EMAIL=noreply@noonealone.com
